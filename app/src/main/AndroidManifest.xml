<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required (Android 13+) to post the re-posted SILENCE / CUSTOM_SOUND
         notifications from BucketExecutor and the wake-up digest. Requested at
         runtime by onboarding; declared here so notify() calls are valid. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- NotificationMapper looks up starred contacts to match "favorite
         contact" rule conditions. Runtime grant is requested by onboarding; the
         mapper degrades to isFavoriteContact=false without it. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- So the onboarding "keep the listener alive" step can send the user to
         the battery-optimization exemption prompt. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Reliability: keep-alive foreground service while a profile is active. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Reliability: exact alarms drive precise profile start/end boundaries and
         are a valid context for launching the keep-alive service. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Reliability: re-arm the schedule and re-assert state after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".NfApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Notification Firewall"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotificationFirewall">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="Notification Firewall"
            android:theme="@style/Theme.NotificationFirewall">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The bound listener that sees every posted notification. The system
             binds it via BIND_NOTIFICATION_LISTENER_SERVICE (a privileged
             permission only the platform holds), which is why exported="false"
             is correct: no third-party app may bind it, but the platform still
             can. The user must additionally grant notification access in
             Settings (ACTION_NOTIFICATION_LISTENER_SETTINGS) before it runs. -->
        <service
            android:name=".service.NfListenerService"
            android:exported="false"
            android:label="Notification Firewall"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Keep-alive foreground service, run only while a profile window is
             active. specialUse: our need (pinning the notification listener
             during scheduled windows) doesn't fit a standard FGS type. -->
        <service
            android:name=".service.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the notification firewall filtering during scheduled profile windows" />
        </service>

        <!-- Fired by an exact alarm at each profile-window boundary. Not exported:
             it is triggered only by our own PendingIntent. -->
        <receiver
            android:name=".service.ProfileBoundaryReceiver"
            android:exported="false" />

        <!-- Re-arms the schedule after a reboot. Only listens to the protected
             BOOT_COMPLETED broadcast. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- WorkManager on-demand initialization: remove the default
             initializer so our Hilt-aware Configuration.Provider (NfApplication)
             supplies the HiltWorkerFactory for DigestWorker. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
