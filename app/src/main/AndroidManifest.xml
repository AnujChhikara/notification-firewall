<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required (Android 13+) to post the re-posted SILENCE / CUSTOM_SOUND
         notifications from BucketExecutor and the wake-up digest. Requested at
         runtime by onboarding; declared here so notify() calls are valid. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- NotificationMapper looks up starred contacts to match "favorite
         contact" rule conditions. Runtime grant is requested by onboarding; the
         mapper degrades to isFavoriteContact=false without it. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- So the onboarding "keep the listener alive" step can send the user to
         the battery-optimization exemption prompt. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Reliability: keep-alive foreground service (KeepAliveService) that runs
         only while the wall is armed, so aggressive OEMs don't kill the
         notification listener. See ArmingController.arm()/disarm(). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Declared so Permissions.exactAlarmsAllowed()/exactAlarmSettingsIntent()
         can surface this grant in Settings, but nothing in the current wall
         model actually schedules an AlarmManager exact alarm: that was the
         now-deleted profile layer's start/end boundary scheduling. Kept
         declared (rather than dropped) only because the Settings screen still
         shows and requests this permission; revisit if that UI is removed. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Reliability: re-arm the schedule and re-assert state after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Package visibility (API 30+): without this, PackageManager silently
         filters queryIntentActivities()/getInstalledApplications() down to
         almost nothing, and the Settings "add app" picker for the VIP/block
         lists would show an empty list on a real device instead of the
         user's installed apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NfApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Notification Wall"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotificationFirewall">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="Notification Wall"
            android:theme="@style/Theme.NotificationFirewall">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The bound listener that sees every posted notification. The system
             binds it via BIND_NOTIFICATION_LISTENER_SERVICE (a privileged
             permission only the platform holds), which is why exported="false"
             is correct: no third-party app may bind it, but the platform still
             can. The user must additionally grant notification access in
             Settings (ACTION_NOTIFICATION_LISTENER_SETTINGS) before it runs. -->
        <service
            android:name=".service.NfListenerService"
            android:exported="false"
            android:label="Notification Wall"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Keep-alive foreground service, run only while the wall is armed.
             specialUse: our need (pinning the notification listener while
             armed) doesn't fit a standard FGS type. -->
        <service
            android:name=".service.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the notification firewall filtering while the wall is armed" />
        </service>

        <!-- Quick Settings tile: arms/disarms the wall from the system shade.
             Reads the same live ArmingController.state() as the Wall screen,
             so the two can never disagree. exported="true" plus the
             platform's BIND_QUICK_SETTINGS_TILE permission is the standard,
             required pairing for a tile service: only the System UI process
             holds that permission, so no third-party app can bind it despite
             the exported flag. -->
        <service
            android:name=".service.WallTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_wall"
            android:label="Notification Wall"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Re-asserts armed state after a reboot. Only listens to the protected
             BOOT_COMPLETED broadcast. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- WorkManager on-demand initialization: remove the default
             initializer so our Hilt-aware Configuration.Provider (NfApplication)
             supplies the HiltWorkerFactory every @HiltWorker needs to be
             constructed with its injected dependencies: ReclassifyWorker and
             MaintenanceWorker (both scheduled by WallWorkScheduler) as well as
             the on-demand DigestWorker. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
