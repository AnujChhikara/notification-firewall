<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, no action bar (Compose draws its own chrome), edge-to-edge with
         transparent system bars so the app's black canvas flows behind the
         status and navigation bars. windowBackground matches the Compose canvas
         to avoid a light flash on launch. -->
    <style name="Theme.NotificationFirewall" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nf_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
